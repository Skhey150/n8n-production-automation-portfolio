    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.body.lineItems;\nconst orderId = $input.first().json.body.orderId;\nconst currency = $input.first().json.body.currency;\n\nreturn items.map(item => {\n  return {\n    json: {\n      orderId: orderId,\n      sku: item.sku,\n      quantitySold: item.qty,\n      unitPriceUSD: item.unitPrice,\n      totalUSD: item.qty * item.unitPrice,\n      // Automated currency conversion: USD to ZAR (South African Rand)\n      totalZAR: (item.qty * item.unitPrice * 18.50).toFixed(2)\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
