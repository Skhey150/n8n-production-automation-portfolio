    {
      "parameters": {
        "jsCode": "// Grab items from Code and Google Sheet using exact node names\nconst code1Items = $('Code').all();\nconst sheetItems = $('Google Sheet').all();\n\nreturn code1Items.map((item, index) => {\n  // Pull stock values from Google Sheet (or fallback defaults if missing)\n  const currentStock = sheetItems[index]?.json?.['Current Stock'] ?? sheetItems[index]?.json?.CurrentStock ?? 10;\n  const reorderLevel = sheetItems[index]?.json?.['Reorder Level'] ?? sheetItems[index]?.json?.ReorderLevel ?? 5;\n  \n  const qtySold = item.json.quantitySold;\n  const newStock = currentStock - qtySold;\n\n  return {\n    json: {\n      sku: item.json.sku,\n      orderId: item.json.orderId,\n      quantitySold: qtySold,\n      oldStock: currentStock,\n      newStock: newStock,\n      reorderLevel: reorderLevel,\n      isLowStock: newStock <= reorderLevel\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        0
      ],
